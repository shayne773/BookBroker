# Base URL of the BookBroker API. Vite compiles this into the bundle at build
# time, so every environment needs its own build with its own value:
#   local dev  -> http://localhost:5000 (back-end/server.js default port)
#   Vercel     -> set VITE_SERVER_ADDRESS per environment, then redeploy
# Copy this file to .env.local (git-ignored) to set it for local development.
VITE_SERVER_ADDRESS=http://localhost:5000
