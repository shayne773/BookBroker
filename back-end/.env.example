# Copy to back-end/.env and fill in. Never commit the real .env.

# --- Required ---

# MongoDB connection string.
MONGODB_URI=

# Secret used to sign JWTs. Use a long random value, unique per environment.
JWT_SECRET=

# --- Optional ---

# Port the API listens on. Default: 5000
# PORT=5000

# Comma-separated list of browser origins allowed to call this API.
# Outside production, unset falls back to the local development front end
# (http://localhost:3000) only. With NODE_ENV=production it is REQUIRED: the API
# refuses to start without it rather than serving a non-deployed origin.
#   CORS_ALLOWED_ORIGINS=https://your-front-end.example.com,https://www.your-front-end.example.com
# CORS_ALLOWED_ORIGINS=http://localhost:3000
