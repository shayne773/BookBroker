# Copy to back-end/.env and fill in. Never commit the real .env.

# --- Required ---

# MongoDB connection string.
MONGODB_URI=

# Secret used to sign JWTs. Use a long random value, unique per environment.
JWT_SECRET=

# --- Optional ---

# Port the API listens on. Default: 5000
# PORT=5000

# Comma-separated list of browser origins allowed to call this API.
# Unset falls back to the local development front end (http://localhost:3000)
# only, so a misconfigured deployment fails closed rather than accepting every
# origin. Set it to the deployed front-end origin(s) before serving traffic:
#   CORS_ALLOWED_ORIGINS=https://your-front-end.example.com,https://www.your-front-end.example.com
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API (e.g. "1" behind a single load
# balancer), or any value Express's "trust proxy" setting accepts. Required for
# login rate limiting to see the real client address rather than the balancer's.
# Leave unset when the process is exposed directly.
# TRUST_PROXY=1

# Login brute-force protection (see back-end/lib/loginThrottle.js).
# Failed sign-ins are counted per account and per client address; passing either
# limit locks that key out for LOGIN_THROTTLE_LOCKOUT_MS.
# LOGIN_THROTTLE_WINDOW_MS=900000
# LOGIN_THROTTLE_LOCKOUT_MS=900000
# LOGIN_THROTTLE_ACCOUNT_MAX=5
# LOGIN_THROTTLE_IP_MAX=30
