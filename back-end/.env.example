# Copy to back-end/.env and fill in. Never commit the real .env.

# --- Required ---

# MongoDB connection string.
MONGODB_URI=

# --- Optional ---

# Port the API listens on. Default: 5000
# PORT=5000

# Comma-separated list of browser origins allowed to call this API.
# Outside production, unset falls back to the local development front end
# (http://localhost:3000) only. With NODE_ENV=production it is REQUIRED: the API
# refuses to start without it rather than serving a non-deployed origin.
#   CORS_ALLOWED_ORIGINS=https://your-front-end.example.com,https://www.your-front-end.example.com
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Google Books ---

# Server-side Google Books API key (Google Cloud console, Books API enabled;
# free tier 1,000 requests a day). Every Google Books request goes through the
# API with it: the book search proxy (/google-books/*) and `npm run seed`.
# Keyless requests share Google's global anonymous quota, which is routinely
# zero, so without it book search answers "temporarily unavailable" and the
# seed refuses to start. Never expose it to the
# front end (no VITE_ variable).
# GOOGLE_BOOKS_API_KEY=

# --- Email (account emails, and notifications of messages, trades and wishlist matches) ---

# Resend API key. Unset (local development, tests, CI) means nothing is sent:
# each email's recipient, subject and link are logged to the console instead.
# RESEND_API_KEY=

# Sender address. Default: BookBroker <onboarding@resend.dev>, Resend's shared
# test sender, which delivers only to the Resend account owner's own address.
# Mail to real users needs a domain verified in Resend and a sender on it.
# EMAIL_FROM=BookBroker <hello@your-domain.example>

# Base URL of the deployed front end; emailed links point here. Outside
# production, unset falls back to http://localhost:3000. With NODE_ENV=production
# it is REQUIRED: the API refuses to start without it.
# FRONTEND_BASE_URL=https://your-front-end.example.com

# Express "trust proxy" setting, so the per-client limits on resend confirmation
# and forgot password see the caller's address rather than the load balancer's.
# Set it to the number of proxies in front of the API (e.g. 1 behind one AWS
# load balancer). Unset, X-Forwarded-For is ignored.
# TRUST_PROXY=1

# --- Admin ---

# Comma-separated emails of the admin accounts, compared case-insensitively
# against each account's confirmed email. Admins see the reports page
# (/admin/reports in the front end) and can suspend and unsuspend readers.
# There is no admin sign-up or role editing: this list is the whole of it.
# Unset or empty, nobody is an admin.
# ADMIN_EMAILS=you@example.com,colleague@example.com
